# ------------------------------------------------------------------
#  YOUR ALPACA API KEYS GO HERE
#
#  1. Copy this file and name the copy exactly:  .env
#     (same folder as this file; no name before the dot)
#  2. Log in at https://app.alpaca.markets, make sure the top-left
#     switcher says "Paper Trading", then generate API keys on the
#     dashboard (right-hand side, "API Keys" -> "Generate New Keys").
#  3. Paste them below, replacing the placeholder text. No quotes,
#     no spaces around the "=".
#
#  .env is listed in .gitignore, so your keys never get committed.
#  Never paste your keys into a chat or share this file.
# ------------------------------------------------------------------

ALPACA_API_KEY=your_api_key_id_here
ALPACA_SECRET_KEY=your_secret_key_here

# Leave this as true. Setting it to false points the bot at real money,
# and the bot will still refuse unless you also run it with --live.
ALPACA_PAPER=true
